# Public URL of the Beeline API (not a secret; the browser calls it directly).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Public GitHub repository link shown on the site.
NEXT_PUBLIC_REPO_URL=https://github.com/dev-doji/beeline-relay

# Privy app ID (public, safe to expose): turns on email sign-in and a NEAR wallet for the /chat app. Leave empty to keep it off.
NEXT_PUBLIC_PRIVY_APP_ID=
