# Beeline Relay API — copy to beeline-api/.env and fill in. Placeholders only; never commit real values.

# Required for local startup
PORT=8080
APP_ENV=development            # development | test | production
LOG_LEVEL=info                 # debug | info | warn | error
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MIGRATE_ON_START=true

# Required for live provider calls (backend only — never expose to the browser)
NEAR_INTENTS_API_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=          # partner JWT from partners.near-intents.org; optional, adds fees if empty


# NEAR AI Cloud (AI reviewer). Real key goes in beeline-api/.env only.
NEAR_AI_API_KEY=
