# Beeline Relay API — copy to beeline-api/.env and fill in. Placeholders only; never commit real values.

# Required for local startup
PORT=8080
APP_ENV=development            # development | test | production
LOG_LEVEL=info                 # debug | info | warn | error
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MIGRATE_ON_START=true

# Required for live provider calls (backend only — never expose to the browser)
NEAR_INTENTS_API_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=          # partner JWT from partners.near-intents.org; optional, adds fees if empty


# NEAR AI Cloud (AI reviewer). Real key goes in beeline-api/.env only.
NEAR_AI_API_KEY=
NEAR_AI_REVIEW_MODEL=z-ai/glm-5.3-flash

# Public playground (TESTNET only). Leave PLAYGROUND_VAULT empty to disable it.
PLAYGROUND_VAULT=
# Either point at the folder cmd/vault-testnet writes (local) ...
PLAYGROUND_KEYS_DIR=
# ... or set the TESTNET keys directly (deployment). Never use mainnet keys here.
PLAYGROUND_AGENT_KEY=
PLAYGROUND_QUOTE_SIGNER_KEY=
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
PLAYGROUND_RUNS_PER_MINUTE=4
PLAYGROUND_RUNS_PER_DAY=300
